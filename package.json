{
	"name": "@7c/public-ip",
	"version": "8.0.2",
	"description": "Get your public IP address — very fast!",
	"license": "MIT",
	"repository": "7c/public-ip",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"browser": "./dist/browser.js",
			"node": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/browser.js"
		}
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run clean && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.test.json",
		"test": "npm run typecheck && jest",
		"test:unit": "jest test/unit.test.ts test/index.test.ts",
		"test:live": "jest test/live.test.ts",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"get",
		"ip",
		"ipv4",
		"ipv6",
		"address",
		"external",
		"public",
		"machine",
		"fast",
		"opendns",
		"dns"
	],
	"dependencies": {
		"dns-socket": "^4.2.2"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^20.19.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.2.5",
		"typescript": "^5.9.2"
	}
}
